# Copy to .env and fill in before running scripts/deploy/deploy.sh.
#   cp .env.example .env
# Keys and shape follow docs/TRANCHE_2_3_TECHNICAL_SPECIFICATION.md §5.3 exactly, with one
# deliberate addition noted below (ISSUER_KEY/ADMIN_KEY key separation). Plain shell: no spaces
# around `=`, quote anything with spaces. Testnet: local keys are fine (§12.1). Mainnet: these
# must move to multisig/hardware/controlled-signer custody before use -- do not reuse a .env
# built this way for a mainnet run.

NETWORK=testnet
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# The spec's §5.3 schema names one combined `STELLAR_SOURCE_ACCOUNT`. This repo already adopted
# a two-key split in an earlier dApp-integration round (docs/DEPLOYMENT.md "Key roles"): a faucet
# or any other tool that only needs ADMIN_KEY's powers should never also need issuer authority.
# ISSUER_KEY must be the underlying asset's real, live issuer (six contracts check this on-chain
# and revert IssuerMismatch otherwise). ADMIN_KEY is for OracleAdapter/Permissioning/RiskControl/
# Router, none of which check against the issuer. Both are `stellar keys` identity names, not
# raw secrets; deploy.sh derives each one's G-address itself (`stellar keys address`) rather than
# taking it as a separate .env field, to avoid a redundant value that could drift out of sync.
ISSUER_KEY=admin
ADMIN_KEY=protocol_admin

UNDERLYING_SAC=
PROTOCOL_ADMIN_ADDRESS=
TREASURY_ADDRESS=

# Unix timestamp. Leave blank to default to 90 days from the moment deploy.sh runs (the spec's
# own "first market set to about 90 days" default, §5.3).
MARKET_MATURITY_UNIX=

TOKENIZATION_FEE_BPS=5
YT_FEE_BPS=1000
SWAP_FEE_TIER_BPS=10
PROTOCOL_SHARE_BPS=2000
TIME_STRETCH_YEARS=2

# 0 disables RiskControl's circuit breaker. Set a non-zero protocol-wide limit (underlying units)
# appropriate for initial TVL before real deposits start. RISK_ASSET_LIMIT is an optional
# additional per-asset cap on the underlying itself (blank = none). RISK_WINDOW_LEDGERS defaults
# to RiskControl's own on-chain default (17280 ledgers, ~24h) -- only set_window_ledgers if this
# differs from that default.
RISK_CB_LIMIT=0
RISK_ASSET_LIMIT=
RISK_WINDOW_LEDGERS=17280

# At SCALE = 1e7: 10000000 = 1.00. Leave ORACLE_INITIAL_TIMESTAMP blank to use "now" at run time.
ORACLE_INITIAL_VALUE=10000000
ORACLE_INITIAL_TIMESTAMP=
ORACLE_MAX_STALE_SECONDS=3600
ORACLE_MAX_DEVIATION_BPS=1000

# Optional, beyond the funded spec (see OracleAdapter's own module doc and
# docs/ORACLE_SAFETY_EXTENSION.md "Pulling from a SEP-40 feed"): if set, deploy.sh also wires
# OracleAdapter.set_feed_source to pull from this contract on top of the manual genesis value
# above. Do not point this at a guessed address -- confirm the real deployed feed address from
# RedStone's own current docs/app first. SEP-40's Asset enum is `Stellar(Address)` or
# `Other(Symbol)`: set KIND to one of those two and VALUE to the matching address or symbol.
ORACLE_FEED_ADDRESS=
ORACLE_FEED_ASSET_KIND=
ORACLE_FEED_ASSET_VALUE=

# Space-separated list of additional accounts to grant compliance standing to, beyond the new
# market's own contracts and the treasury (which are always granted) -- e.g. known test users.
EXTRA_COMPLIANCE_ACCOUNTS=

WASM_DIR=target/wasm32v1-none/release
MANIFEST=deployments/testnet/deployment-manifest.json
