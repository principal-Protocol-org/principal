# Rust / Cargo build artifacts
target/

# scripts/deploy/deploy.sh's own local config -- copy .env.example to .env (or a named variant,
# e.g. .env.mainnet-mockusdy, for a specific deployment run) and fill it in; none of these must
# ever be committed (they name local `stellar keys` identities and, on a real mainnet run, would
# be adjacent to signer material).
.env
.env.*
!.env.example
# Note: Cargo.lock is committed for smart contracts to guarantee reproducible WASM builds.

# Grant and business documents — not part of the public technical release
MARKET_OPPORTUNITY.md
WORKING_NOTES.md

# Source PDF and Windows metadata
*.PDF
*.pdf
*Zone.Identifier
*:Zone.Identifier

# Editor / OS / local tooling
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.claude/

# Soroban WASM output
*.wasm

# Soroban test snapshots for the new crates and the integration suite: regenerated by every test
# run and far too numerous to review. (Existing per-contract snapshot directories stay tracked.)
contracts/integration_tests/test_snapshots/
contracts/compliance/test_snapshots/
contracts/market_config/test_snapshots/
contracts/market_pool/test_snapshots/
contracts/router/test_snapshots/
contracts/recovery_escrow/test_snapshots/
contracts/market_factory/test_snapshots/

# mdBook output
/book/
deployments/*/deployment-manifest.json.*.bak
__pycache__/
